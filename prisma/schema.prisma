generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Reservation {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique // normalized digits, so a repeat rsvp updates the same row
  plusOne   Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String   @unique // cloudinary secure_url
  hidden    Boolean  @default(false) // staff can pull a photo from the public gallery
  createdAt DateTime @default(now())
}
